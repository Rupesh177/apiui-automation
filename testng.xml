<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Automation Suite" parallel="tests" thread-count="3">

    <!-- Listeners -->
    <listeners>
        <listener class-name="rupesh.apiui.listeners.TestListener"/>
        <listener class-name="io.qameta.allure.testng.AllureTestNg"/>
        <listener class-name="rupesh.apiui.listeners.RetryListener"/>
    </listeners>

    <!-- UI Tests -->
    <test name="UI Tests">
        <groups>
            <run>
                <include name="ui"/>
            </run>
        </groups>
        <classes>
            <class name="rupesh.apiui.tests.ui.LoginTest"/>
        </classes>
    </test>

    <!-- API Tests -->
    <test name="API Tests">
        <groups>
            <run>
                <include name="api"/>
            </run>
        </groups>
        <packages>
            <package name="rupesh.apiui.tests.api"/>
        </packages>
    </test>
</suite>

